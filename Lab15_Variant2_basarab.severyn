#include <iostream>
using namespace std;

int main()
{
    int n;
    cout << "Enter n: ";
    cin >> n;

    int array[100];
    int k = 0;

    for (int i = 1; i <= n; i++)
    {
        if (n % i == 0)
        {
            array[k] = i;
            k++;
        }
    }

    cout << "Array before sorting:" << endl;
    for (int i = 0; i < k; i++)
    {
        cout << array[i] << " ";
    }
    cout << endl;

    int max = 0;
    int temp;

    for (int i = 0; i < k; i++)
    {
        max = i;

        for (int j = i + 1; j < k; j++)
            max = (array[j] > array[max]) ? j : max;

        if (i != max)
        {
            temp = array[i];
            array[i] = array[max];
            array[max] = temp;
        }
    }

    cout << "Array after sorting (descending):" << endl;
    for (int i = 0; i < k; i++)
    {
        cout << array[i] << " ";
    }
    cout << endl;

    return 0;
}
