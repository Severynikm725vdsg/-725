#include <iostream>
using namespace std;

int binarySearch(int array[], int size, int search_num)
{
    int left = 0, right = size - 1;

    while (left <= right)
    {
        int mid = left + (right - left) / 2;

        if (array[mid] == search_num)
            return mid;
        else if (array[mid] < search_num)
            left = mid + 1;
        else
            right = mid - 1;
    }
    return -1;
}

int main()
{
    int number;
    cout << "Enter a six-digit number: ";
    cin >> number;

    int array[1000];
    int count = 0;

    for (int i = 1; i <= number; i++)
    {
        if (number % i == 0)
        {
            array[count++] = i;
        }
    }

    for (int i = 0; i < count - 1; i++)
    {
        for (int j = 0; j < count - i - 1; j++)
        {
            if (array[j] > array[j + 1])
            {
                int temp = array[j];
                array[j] = array[j + 1];
                array[j + 1] = temp;
            }
        }
    }

    int search_num;
    cout << "Enter divisor to search: ";
    cin >> search_num;

    for (int i = 0; i < count; i++)
    {
        cout << array[i] << " ";
    }
    cout << endl;

    int index = binarySearch(array, count, search_num);

    if (index != -1)
    {
        cout << "Element " << search_num << " has index " << index << endl;
    }
    else
    {
        cout << "Element not found in array" << endl;
    }

    return 0;
}
